FROM nousresearch/hermes-agent:latest

# Copia o código e os dados iniciais (seed) do agente de atendimento Zupoo
# Fica em /opt/zupoo-locadora-agente para não conflitar com o volume /opt/hermes
COPY zupoo-locadora-agente/src /opt/zupoo-locadora-agente/src
COPY zupoo-locadora-agente/data /opt/zupoo-locadora-agente/data-seed
COPY zupoo-locadora-agente/README.md /opt/zupoo-locadora-agente/README.md
COPY zupoo-locadora-agente/requirements.txt /opt/zupoo-locadora-agente/requirements.txt

# Salva os scripts de entrypoint oficiais fora de /opt/hermes
# (evita quebra quando um volume antigo hermes-agent-src-v2 monta sobre /opt/hermes)
RUN if [ -d /opt/hermes/docker ]; then \
        mkdir -p /usr/local/lib/hermes-docker && cp -a /opt/hermes/docker/. /usr/local/lib/hermes-docker/; \
    fi

# Script de entrada que inicia o webhook Zupoo em background e delega ao Hermes oficial
COPY docker/hermes-zupoo-entrypoint.sh /usr/local/bin/hermes-zupoo-entrypoint.sh
RUN sed -i 's/\r$//' /usr/local/bin/hermes-zupoo-entrypoint.sh \
    && chmod +x /usr/local/bin/hermes-zupoo-entrypoint.sh

EXPOSE 8081

ENTRYPOINT ["/usr/local/bin/hermes-zupoo-entrypoint.sh"]
